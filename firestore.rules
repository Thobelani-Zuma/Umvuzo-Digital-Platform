rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Transaction records
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }
    
    // Daily opening & closing cash balances
    match /dailyBalances/{date} {
      allow read, write: if request.auth != null;
    }
  }
}
